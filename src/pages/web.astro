---
import ServiceLayout from "../layouts/ServiceLayout.astro";
---

<ServiceLayout
  title="Web"
  subtitle="Website repair, cleanup, and performance-focused rebuilds."
>
  <section>
    <h2 class="text-xl font-semibold tracking-tight">
      What this includes
    </h2>

    <ul class="mt-4 space-y-2 text-neutral-700">
      <li>Website repair and cleanup</li>
      <li>Performance and loading improvements</li>
      <li>Layout and content fixes</li>
      <li>Modern rebuilds when needed</li>
    </ul>
  </section>

  <section>
    <h2 class="text-xl font-semibold tracking-tight">
      How it’s typically used
    </h2>

    <p class="mt-4 text-neutral-700 max-w-2xl">
      Web work focuses on removing friction — simplifying structure, improving
      speed, and making sites easier to maintain.
    </p>
  </section>

  <section>
    <div class="rounded-2xl bg-neutral-50 p-6 text-sm text-neutral-600">
      Selected web projects coming soon.
    </div>
  </section>
</ServiceLayout>
