---
import ServiceLayout from "../layouts/ServiceLayout.astro";
---

<ServiceLayout
  title="Video"
  subtitle="Editing, pacing, and refinement for clean, intentional visual storytelling."
>
  <section>
    <h2 class="text-xl font-semibold tracking-tight">
      What this includes
    </h2>

    <ul class="mt-4 space-y-2 text-neutral-700">
      <li>Video editing and assembly</li>
      <li>Color correction</li>
      <li>Sound integration</li>
      <li>Exports for web and social</li>
    </ul>
  </section>

  <section>
    <h2 class="text-xl font-semibold tracking-tight">
      How it’s typically used
    </h2>

    <p class="mt-4 text-neutral-700 max-w-2xl">
      Video work is focused on pacing and restraint — shaping footage into
      something that feels intentional and complete.
    </p>
  </section>

  <section>
    <div class="rounded-2xl bg-neutral-50 p-6 text-sm text-neutral-600">
      Featured video work coming soon.
    </div>
  </section>
</ServiceLayout>
