---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout title="Contact">
  <main class="mx-auto max-w-3xl px-4 py-16 pb-28 md:pb-16">
    <section>
      <p class="text-sm font-medium tracking-wide text-neutral-500">CONTACT</p>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        Start a conversation
      </h1>

      <p class="mt-6 max-w-xl text-lg text-neutral-700">
        Tell me a bit about what you're working on.
      </p>

      <form
        id="contact-form"
        method="POST"
        action="/api/contact"
        class="mt-10 space-y-6 rounded-2xl bg-neutral-50 p-6 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.08)]"
      >
        <div class="space-y-2">
          <label for="name" class="text-sm font-medium text-neutral-800">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            autocomplete="name"
            class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 focus:border-neutral-900 focus:outline-none"
          />
        </div>

        <div class="space-y-2">
          <label for="email" class="text-sm font-medium text-neutral-800">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
            class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 focus:border-neutral-900 focus:outline-none"
          />
        </div>

        <div class="space-y-2">
          <label for="message" class="text-sm font-medium text-neutral-800">Message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            class="w-full rounded-xl border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 focus:border-neutral-900 focus:outline-none"
          ></textarea>
        </div>

        <!-- Managed Turnstile, visually subtle -->
        <div
          class="cf-turnstile turnstile"
          data-sitekey={siteKey}
          data-appearance="interaction-only"
        ></div>

        <div class="pt-2">
          <button
            type="submit"
            class="inline-flex items-center justify-center rounded-full bg-neutral-900 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-neutral-800 cursor-pointer"
          >
            Send message
          </button>
        </div>
      </form>
    </section>
  </main>

  <!-- Success dialog -->
  <dialog
    id="contact-success"
    class="w-[min(520px,calc(100vw-2rem))] rounded-2xl bg-white p-0 shadow-2xl backdrop:bg-black/55"
  >
    <div class="p-6 md:p-7">
      <p class="text-sm font-medium tracking-wide text-neutral-500">SENT</p>
      <h2 class="mt-2 text-2xl font-semibold tracking-tight">Message received</h2>
      <p class="mt-3 text-sm text-neutral-700">
        Thanks for reaching out. Typical reply time: 1-2 days.
      </p>

      <div class="mt-6 flex justify-end">
        <button
          type="button"
          data-close-success
          class="rounded-full border border-neutral-300 bg-white px-5 py-3 text-sm font-medium text-neutral-900 hover:bg-neutral-50 cursor-pointer"
        >
          Close
        </button>
      </div>
    </div>
  </dialog>

  <!-- Turnstile script -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <script>
  // @ts-nocheck
  const dialog = document.getElementById("contact-success");
  const closeBtn = document.querySelector("[data-close-success]");

  function openSuccess() {
    if (!dialog) return;
    if (typeof dialog.showModal === "function") dialog.showModal();
    else dialog.setAttribute("open", "");

    try {
      const url = new URL(window.location.href);
      url.searchParams.delete("sent");
      window.history.replaceState({}, "", url.toString());
    } catch {}
  }

  // Static Astro page, so check query params in the browser
  try {
    const params = new URLSearchParams(window.location.search);
    if (params.get("sent") === "1") openSuccess();
  } catch {}

  closeBtn?.addEventListener("click", () => {
    try { dialog?.close?.(); } catch {}
  });
</script>

  <style>
    /* Keep Turnstile present but visually quiet */
    .turnstile {
      margin-top: 0.75rem;
      opacity: 0.55;
      transform: scale(0.92);
      transform-origin: left;
    }

    @media (max-width: 640px) {
      .turnstile {
        transform-origin: center;
      }
    }
  </style>
</BaseLayout>