---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact">
  <main class="mx-auto max-w-3xl px-4 py-16 pb-28 md:pb-16">
    <section>
      <p class="text-sm font-medium tracking-wide text-neutral-500">
        CONTACT
      </p>

      <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
        Start a conversation
      </h1>

      <p class="mt-6 max-w-xl text-lg text-neutral-700">
        Tell me a bit about what you’re working on and what you want it to feel like.
      </p>

      <div class="mt-10 rounded-2xl bg-neutral-50 p-6 text-sm text-neutral-600">
        Contact form coming soon.
      </div>
    </section>
  </main>
</BaseLayout>
