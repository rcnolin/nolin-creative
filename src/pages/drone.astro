---
import ServiceLayout from "../layouts/ServiceLayout.astro";
---

<ServiceLayout
  title="Drone"
  subtitle="Drone video, photo, and pano360 capture with a focus on clarity and composition."
>
  <section>
    <h2 class="text-xl font-semibold tracking-tight">
      What this includes
    </h2>

    <ul class="mt-4 space-y-2 text-neutral-700">
      <li>Drone video capture</li>
      <li>Drone photography</li>
      <li>Equirectangular pano360 images</li>
      <li>Location planning and flight execution</li>
    </ul>
  </section>

  <section>
    <h2 class="text-xl font-semibold tracking-tight">
      How it’s typically used
    </h2>

    <p class="mt-4 text-neutral-700 max-w-2xl">
      Drone work is used to establish place, scale, and movement — often as a
      visual anchor for larger projects.
    </p>
  </section>

  <section>
    <div class="rounded-2xl bg-neutral-50 p-6 text-sm text-neutral-600">
      Featured drone work coming soon.
    </div>
  </section>
</ServiceLayout>
