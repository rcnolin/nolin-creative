---
const items = [
  {
    id: "pano360-01",
    title: "Drone pano360",
    type: "pano",
    tag: "PANORAMA",
    description:
      "Equirectangular pano captured from drone. Designed for smooth interactive viewing.",
    src: "/panos/GriffithWoods360.JPG",
    thumb: "/thumbs/GriffithWoods360-thumb.jpg",
  },
  {
    id: "video-01",
    title: "Video edit",
    type: "video",
    tag: "VIDEO",
    description:
      "Tight cuts, pacing, and sound design. Built for clean, high-impact delivery.",
  },
  {
    id: "audio-01",
    title: "Custom soundtrack",
    type: "audio",
    tag: "AUDIO",
    description:
      "Original composition shaped to mood and motion.",
  },
];
---

<section>
  <div class="rounded-2xl bg-neutral-50 p-6 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.08)] md:p-8">
    <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-medium tracking-wide text-neutral-500">FEATURED WORK</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-tight md:text-3xl">
          A few recent projects.
        </h2>
      </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
      {items.map((item) => (
        <button
          type="button"
          class="group cursor-pointer text-left overflow-hidden rounded-2xl bg-white shadow-[inset_0_0_0_1px_rgba(0,0,0,0.10)] transition hover:shadow-[inset_0_0_0_1px_rgba(0,0,0,0.22)]"
          data-work-open
          data-title={item.title}
          data-type={item.type}
          data-tag={item.tag}
          data-description={item.description}
          data-src={item.src ?? ""}
        >
          <div class="relative aspect-16/10 overflow-hidden bg-neutral-200">
            {item.thumb && (
              <>
                <img
                  src={item.thumb}
                  alt=""
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
                <div class="absolute inset-0 bg-black/0 transition group-hover:bg-black/10"></div>
              </>
            )}
          </div>

          <div class="p-5">
            <div class="flex items-center justify-between gap-4">
              <h3 class="text-base font-semibold tracking-tight">{item.title}</h3>
              <span class="text-sm text-neutral-500 transition group-hover:text-neutral-900">→</span>
            </div>
            <p class="mt-2 text-sm text-neutral-600">{item.description}</p>
            <p class="mt-4 text-xs font-medium tracking-wide text-neutral-500">{item.tag}</p>
          </div>
        </button>
      ))}
    </div>
  </div>

  <!-- Modal -->
  <div data-work-modal class="fixed inset-0 z-999 hidden" aria-hidden="true">
    <div data-work-backdrop class="absolute inset-0 bg-black/50"></div>

    <div class="absolute inset-0 flex items-center justify-center px-0 pb-[env(safe-area-inset-bottom)] md:px-4 md:pb-0">
      <div
        class="h-dvh w-full bg-white shadow-xl pb-[max(3.5rem,env(safe-area-inset-bottom))] md:h-auto md:max-w-7xl md:rounded-2xl md:pb-0"
        role="dialog"
        aria-modal="true"
      >
        <div class="flex items-start justify-between gap-6 px-6 pt-6">
          <div>
            <p data-work-tag class="text-xs font-medium tracking-wide text-neutral-500"></p>
            <h3 data-work-title class="mt-2 text-xl font-semibold tracking-tight md:text-2xl"></h3>
          </div>

          <button
            type="button"
            data-work-close
            class="inline-flex h-10 w-10 cursor-pointer items-center justify-center rounded-full hover:bg-neutral-100 transition-colors"
          >
            <span class="text-2xl leading-none">✕</span>
          </button>
        </div>

        <div class="px-6 pb-24 pt-5 md:pb-6">
          <div
            data-work-viewer
            class="h-[70dvh] w-full overflow-hidden rounded-none bg-neutral-200 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.12)] md:h-[65vh] md:max-h-187.5 md:rounded-2xl"
          ></div>

          <p data-work-description class="mt-5 text-sm text-neutral-700"></p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href="/contact"
              class="rounded-full bg-neutral-900 px-5 py-3 text-sm font-medium text-white hover:bg-neutral-800 transition-colors"
            >
              Start a project
            </a>

            <button
              type="button"
              data-work-secondary-close
              class="cursor-pointer rounded-full border border-neutral-300 px-5 py-3 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-200"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
  // @ts-nocheck

  /** @type {HTMLElement | null} */
  const modal = document.querySelector("[data-work-modal]");
  /** @type {HTMLElement | null} */
  const backdrop = document.querySelector("[data-work-backdrop]");
  /** @type {HTMLButtonElement | null} */
  const closeBtn = document.querySelector("[data-work-close]");
  /** @type {HTMLButtonElement | null} */
  const closeBtn2 = document.querySelector("[data-work-secondary-close]");

  /** @type {HTMLElement | null} */
  const titleEl = document.querySelector("[data-work-title]");
  /** @type {HTMLElement | null} */
  const tagEl = document.querySelector("[data-work-tag]");
  /** @type {HTMLElement | null} */
  const descEl = document.querySelector("[data-work-description]");
  /** @type {HTMLElement | null} */
  const viewerEl = document.querySelector("[data-work-viewer]");

  /** @type {HTMLElement[]} */
  const openButtons = Array.from(document.querySelectorAll("[data-work-open]"));

  /** @type {any} */
  let panoViewer = null;

  /**
   * @param {string} text
   */
  function setViewerPlaceholder(text) {
    if (!viewerEl) return;

    viewerEl.innerHTML = "";
    viewerEl.classList.add("bg-neutral-200");
    viewerEl.style.background = "";

    const label = document.createElement("div");
    label.className =
      "h-full w-full flex items-center justify-center text-sm text-neutral-600";
    label.textContent = text;
    viewerEl.appendChild(label);
  }

  /**
   * @param {string} panoUrl
   */
  async function mountPano(panoUrl) {
    if (!viewerEl) return;

    viewerEl.innerHTML = "";
    viewerEl.classList.remove("bg-neutral-200");
    viewerEl.style.background = "#111";

    await import("@photo-sphere-viewer/core/index.css");
    const mod = await import("@photo-sphere-viewer/core");
    const Viewer = mod.Viewer;

    if (panoViewer) {
      try {
        panoViewer.destroy();
      } catch {}
      panoViewer = null;
    }

    panoViewer = new Viewer({
      container: viewerEl,
      panorama: panoUrl,
      navbar: false,
      mousewheel: true,
      touchmoveTwoFingers: false,
    });
  }

  /**
   * @param {HTMLElement} btn
   */
  async function openModal(btn) {
    if (!modal) return;

    const title = btn.getAttribute("data-title") || "";
    const tag = btn.getAttribute("data-tag") || "";
    const description = btn.getAttribute("data-description") || "";
    const type = btn.getAttribute("data-type") || "";
    const src = btn.getAttribute("data-src") || "";

    if (titleEl) titleEl.textContent = title;
    if (tagEl) tagEl.textContent = tag;
    if (descEl) descEl.textContent = description;

    modal.classList.remove("hidden");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    document.body.classList.add("modal-open");

    closeBtn?.focus();

    if (type === "pano") {
      if (!src) {
        setViewerPlaceholder("Pano360 source not set");
        return;
      }
      setViewerPlaceholder("Loading pano360…");
      try {
        await mountPano(src);
      } catch (err) {
        console.error(err);
        setViewerPlaceholder("Could not load pano360");
      }
      return;
    }

    if (type === "video") return setViewerPlaceholder("Video player placeholder");
    if (type === "audio") return setViewerPlaceholder("Audio player placeholder");
    setViewerPlaceholder("Media placeholder");
  }

  function closeModal() {
    if (!modal) return;

    if (panoViewer) {
      try {
        panoViewer.destroy();
      } catch {}
      panoViewer = null;
    }

    modal.classList.add("hidden");
    modal.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    document.body.classList.remove("modal-open");
  }

  openButtons.forEach((btn) => {
    btn.addEventListener("click", () => openModal(btn));
  });

  backdrop?.addEventListener("click", closeModal);
  closeBtn?.addEventListener("click", closeModal);
  closeBtn2?.addEventListener("click", closeModal);

  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>
</section>
