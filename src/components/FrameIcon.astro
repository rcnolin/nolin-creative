---
const { name, class: className = "" } = Astro.props;
---

{ name === "audio" && (
  <svg
    viewBox="0 0 24 24"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M9 18V7l10-2v11" />
    <circle cx="7" cy="18" r="2" />
    <circle cx="17" cy="16" r="2" />
  </svg>
)}

{ name === "drone" && (
  <svg
    viewBox="0 0 24 24"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M9 12h6" />
    <path d="M10.5 7.5h3" />
    <path d="M8 14.5c0 2 1.8 3.5 4 3.5s4-1.5 4-3.5-1.8-3.5-4-3.5-4 1.5-4 3.5Z" />
    <path d="M4.5 7.5h4M15.5 7.5h4" />
  </svg>
)}

{ name === "video" && (
  <svg
    viewBox="0 0 24 24"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="4.5" y="7" width="12.5" height="10" rx="2" />
    <path d="M17 10l3-2v8l-3-2z" />
  </svg>
)}

{ name === "web" && (
  <svg
    viewBox="0 0 24 24"
    class={className}
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="4" y="5.5" width="16" height="13" rx="2" />
    <path d="M4 9h16" />
    <path d="M8 13h8" />
  </svg>
)}
