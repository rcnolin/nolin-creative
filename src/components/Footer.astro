---
const year = new Date().getFullYear();
---

<footer class="mt-8 border-t border-neutral-200 py-10 pb-28 md:pb-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 md:flex-row md:items-center md:justify-between">
    <div>
      <p class="text-sm font-semibold tracking-tight text-neutral-900">
        Nolin Creative
      </p>
      <p class="mt-1 text-sm text-neutral-600">
        Audio • Drone • Video • Web
      </p>
    </div>

    <nav class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a class="text-neutral-600 hover:text-neutral-900 transition-colors" href="/audio">Audio</a>
      <a class="text-neutral-600 hover:text-neutral-900 transition-colors" href="/drone">Drone</a>
      <a class="text-neutral-600 hover:text-neutral-900 transition-colors" href="/video">Video</a>
      <a class="text-neutral-600 hover:text-neutral-900 transition-colors" href="/web">Web</a>
      <a class="text-neutral-600 hover:text-neutral-900 transition-colors" href="/contact">Contact</a>
    </nav>

    <p class="text-sm text-neutral-500">
      © {year} Nolin Creative
    </p>
  </div>
</footer>
